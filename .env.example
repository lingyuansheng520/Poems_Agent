# 复制本文件为 backend/.env 后填写真实值
# 注意：真实填写的 backend/.env 已在 .gitignore 中忽略，禁止提交；本模板文件可以提交。
# 复制命令（Windows）： copy .env.example backend\.env

# ---------------------------------------------------------------------------
# 大模型服务（检索重写 / 答案生成）
# 当前链路：rewrite 与 generate 均使用 DeepSeek
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 备选大模型（小米 MiMo），暂未在链路中启用
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# ---------------------------------------------------------------------------
# 数据库（认证 / 会话模块使用）
# 注意：代码用的是 SQLAlchemy 异步引擎，驱动必须是 mysql+aiomysql，
#       写 mysql+pymysql 会在运行时直接报错。
# 示例：mysql+aiomysql://user:password@localhost:3306/dushi
# ---------------------------------------------------------------------------
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/dushi

# ---------------------------------------------------------------------------
# 古籍扫描件 OCR（《标注规范》".docx" 以外的纸质文献数字化时使用）
# ---------------------------------------------------------------------------
PADDLEOCR_TOKEN=your_paddleocr_token_here

# ---------------------------------------------------------------------------
# JWT 认证签名密钥
# 必填。生成方式（任选其一）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -hex 32
# 注意：更换该密钥会让所有已签发的 Token 立即失效。
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=please_generate_a_random_secret_here

# Token 有效期（分钟），缺省 30；开发调试可临时调大，例如 1440（一天）
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# 以下为建议补充项（config.py 暂未读取，可先留空）
# ---------------------------------------------------------------------------
# 语料文件路径，缺省 backend/RAG/knowledge/杜诗.csv
# KNOWLEDGE_PATH=backend/RAG/knowledge/杜诗.csv
# 向量库目录，缺省 backend/vector_db
# VECTOR_DB_DIR=backend/vector_db
# 本地 embedding 模型目录，缺省 backend/embedding_models/bge-base-zh-v1.5
# EMBEDDING_MODEL_PATH=backend/embedding_models/bge-base-zh-v1.5
# 本地 reranker 模型目录
# RERANK_MODEL_PATH=backend/embedding_models/reranker/models/BAAI--bge-reranker-base/snapshots/master
# 检索兜底开关：相似度低于该值时直接拒答，不调用大模型（建议 0.30~0.45 之间试）
# RETRIEVAL_SCORE_THRESHOLD=0.35
